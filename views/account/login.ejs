<%# Content Heading %>

<% if (title) { %>
<h1><%= title %></h1>
<% } else {
  res.redirect('/')
} %>

<%- messages() %>

<% if (errors) { %>
  <ul class="notice">
 <% errors.array().forEach(error => { %>
   <li><%= error.msg %></li>
<%  }) %>
 </ul>
<% } %>

<div class="form-container">
    <form id="loginForm" action="/account/login" method="post">
        <label for="email">
            Email:
            <input type="email" name="account_email" id="email"  placeholder="Enter a valid email address" required>
        </label>

        <label for="password">
            Password:
            <input type="password" id="password" name="account_password" minlength="12" pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$" required>
        </label>

        <div class="submit-btn">
            <button id="submit">Login</button>
        </div>
    </form>

    <div class="switch-link">
        <p>No account? <a href="/account/register">Sign Up</a></p>
    </div>
</div>
