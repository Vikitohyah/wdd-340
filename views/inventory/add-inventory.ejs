<% if (title) { %>
<h1><%= title %></h1>
<% } else {
  res.redirect('/')
} %>

<%- messages() %>

<% if (errors) { %>
  <ul class="notice">
 <% errors.array().forEach(error => { %>
   <li><%= error.msg %></li>
<%  }) %>
 </ul>
<% } %>

<div class="form-container">
    <form action="/inv/add-inventory" method="post">

        <label for="classificationList">
            Classification:
            <%- classificationList %>
        </label>
               
        <label for="inv_make">
            Make:
            <input type="text" id="inv_make" name="inv_make" placeholder="Min of 3 characters" minlength="3" value="<%= locals.inv_make %>" required>
        </label>

        <label for="inv_model">
            Model:
            <input type="text" id="inv_model" name="inv_model" placeholder="Min of 3 characters" minlength="3" value="<%= locals.inv_model %>" required>
        </label>

        <label for="inv_year">
            Year:
            <input type="text" id="inv_year" name="inv_year" placeholder="4-digits only" pattern="[0-9]{4}" value="<%= locals.inv_year %>" required>
        </label>

        <label for="inv_image">
            Image Link:
            <input type="text" id="inv_image" name="inv_image" value="<%= locals.inv_image || '/images/vehicles/no-image.png' %>" required>
        </label>

        <label for="inv_thumbnail">
            Thumbnail Link:
            <input type="text" id="inv_thumbnail" name="inv_thumbnail" value="<%= locals.inv_thumbnail || '/images/vehicles/no-image-tn.png' %>" required>
        </label>

        <label for="inv_price">
            Price:
            <input type="text" id="inv_price" name="inv_price" placeholder="Decimals or Integers" pattern="^\d+(\.\d+)?$" value="<%= locals.inv_price %>" required>
        </label>

        <label for="inv_miles">
            Mileage:
            <input type="text" id="inv_miles" name="inv_miles" placeholder="digits only" pattern="[0-9]*" value="<%= locals.inv_miles %>" required>
        </label>

        <label for="inv_color">
            Color:
            <input type="text" id="inv_color" name="inv_color" placeholder="e.g Purple" value="<%= locals.inv_color %>" required>
        </label>

        <label for="inv_description">
            Description:
        </label>
        <textarea name="inv_description" id="inv_description" rows="3" placeholder="write your description here..." required><%= locals.inv_description %></textarea>

        <div class="submit-btn">
            <button id="submit">Add</button>
        </div>

    </form>
</div>
